# Context Switch — environment template. Copy to .env and fill in.
# .env is gitignored. NEVER commit a real key.
#
# NEVER give a key a VITE_ prefix: VITE_* variables are inlined into the browser bundle.
# Every key below is read only by vite-plugin-ai-proxy.ts, inside the Node process.

# ── Which provider serves requests, and what happens when it fails ──────────
# Primary provider: anthropic | openai | compatible
AI_PROVIDER=anthropic
# Tried in order when the primary fails for a provider-side reason (auth, billing,
# rate limit, missing model, 5xx, timeout). Leave empty for no failover.
AI_FALLBACK_PROVIDERS=openai,compatible

# live | fixture | auto
#   live    = fail visibly with retry if no provider can serve
#   fixture = always use the built-in example responses, no network at all
#   auto    = try live, and offer an example if a built-in situation fails
AI_MODE=auto

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Set this to a model your account can actually use.
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama, …) ──
# All three must be set for this provider to join the chain.
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=

# Deprecated alias for ANTHROPIC_MODEL, still honoured.
# AI_MODEL=claude-sonnet-5
